# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- Modelo de lenguaje (vía LiteLLM) ---
# Opción A (por defecto): gpt-oss-120b en Groq. Key gratuita en https://console.groq.com/keys
LLM_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=

# Opción B: el mismo modelo en local con Ollama (ollama pull gpt-oss:20b)
# LLM_MODEL=ollama_chat/gpt-oss:20b  (el 120b necesita ~65 GB; en local usa el 20b)
# OLLAMA_API_BASE=http://host.docker.internal:11434

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# Ante un 429 (límite por minuto) LiteLLM reintenta y luego usa este modelo de respaldo
LLM_FALLBACK_MODEL=groq/openai/gpt-oss-20b
LLM_NUM_RETRIES=3
LLM_REASONING_EFFORT=low

# --- Seguridad ---
# Clave para firmar los tokens de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=cambia-esta-clave-en-tu-env
JWT_EXPIRES_MINUTES=120

# Contraseña de los usuarios de demostración (datos ficticios)
DEMO_PASSWORD=demo1234

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=3
RAG_MIN_SCORE=0.35

# Fecha de referencia para cálculos de antigüedad. Vacío = hoy. Fija para que los casos del README sean reproducibles.
FECHA_REFERENCIA=2026-11-24

LOG_LEVEL=INFO
